{
  "name": "japanese-practice-pwa",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm lint && pnpm format:check && vitest run",
    "test:e2e": "playwright install chromium && playwright test",
    "format:check": "prettier --check src tests *.ts *.js package.json index.html .prettierrc",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "wanakana": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "@playwright/test": "1.52.0"
  }
}
